# Backend (backend/.env)
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/godavari
JWT_SECRET=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
